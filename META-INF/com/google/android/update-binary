#!/sbin/sh
#################
# Initialization
#################

umask 022

ui_print() { echo "$1"; }

require_new_magisk() {
  ui_print "*******************************"
  ui_print " Please install Magisk v20.4+! "
  ui_print "*******************************"
  exit 1
}

#########################
# Load util_functions.sh
#########################

# shellcheck disable=SC2034  # consumed by util_functions.sh, not used directly in this script
OUTFD=$2
# shellcheck disable=SC2034
ZIPFILE=$3

mount /data 2>/dev/null

[ -f /data/adb/magisk/util_functions.sh ] || require_new_magisk
# shellcheck disable=SC1091  # provided by Magisk on-device at flash time, not present in this repo
. /data/adb/magisk/util_functions.sh
[ "$MAGISK_VER_CODE" -lt 20400 ] && require_new_magisk

install_module
exit 0
